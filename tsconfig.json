{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2020", "DOM"],
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"types": ["@dcloudio/types"]
	},
	"include": ["**/*.ts", "**/*.d.ts"],
	"exclude": ["node_modules", "unpackage", "uniCloud-alipay", "main.ts"]
}
