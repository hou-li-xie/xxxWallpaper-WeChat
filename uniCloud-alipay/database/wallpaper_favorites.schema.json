// 照片收藏表
// 所有读写均通过 wallpaper-action 云函数（管理员权限），clientDB 全部禁止
{
	"bsonType": "object",
	"required": ["wallpaper_id", "user_id", "create_time"],
	"permission": {
		"read": false,
		"create": false,
		"update": false,
		"delete": false
	},
	"properties": {
		"_id": {
			"description": "ID，系统自动生成"
		},
		"wallpaper_id": {
			"title": "照片ID",
			"bsonType": "string",
			"foreignKey": "wallpapers._id"
		},
		"user_id": {
			"title": "收藏用户ID",
			"bsonType": "string",
			"foreignKey": "uni-id-users._id"
		},
		"create_time": {
			"title": "收藏时间",
			"bsonType": "timestamp"
		}
	}
}
